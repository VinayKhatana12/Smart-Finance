# Smart Finance API — environment template
# Copy to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Local (PostgreSQL 14+): postgres://<user>:<password>@localhost:5432/smartfinance
# Hosted (Neon, Supabase, RDS...): the provider's connection string works as-is.
DATABASE_URL=

# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins (the Vite dev server).
# For the packaged Android app add: https://localhost (and capacitor://localhost if used).
CLIENT_ORIGIN=http://localhost:5173

# Cookie SameSite policy: lax for the web app; set "none" (requires HTTPS) when
# the packaged Android app talks to this API from its WebView origin.
COOKIE_SAMESITE=lax
